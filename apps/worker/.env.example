# Copy to .env and fill in. Never commit .env.
# SpacetimeDB: local dev server or Maincloud (wss://maincloud.spacetimedb.com)
STDB_URI=ws://127.0.0.1:3000
STDB_DB=foundation
# Must match the code the admin set with set_worker_pairing_code (16+ chars)
WORKER_PAIRING_CODE=change-me-to-a-long-random-code
# Maritime LLM token (mllm_...). Inside a Maritime agent, OPENAI_API_KEY / OPENAI_BASE_URL are used if these are empty.
MARITIME_LLM_KEY=
MARITIME_BASE_URL=https://api.maritime.sh/api/llm/v1
# Where the agent keeps its MediClaim copy and identity token (use /data/workspace on Maritime)
WORKSPACE_DIR=./.workspace
# Optional
# PORT=8788            # health + POST /chat endpoint (Maritime sets PORT itself)
# PACE=1               # multiplier for pauses between visible steps (0 = fast)
# WORKER_CONCURRENCY=2
# LLM_TIMEOUT_MS=45000
