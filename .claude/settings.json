{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(spacetime *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(node *)",
      "Bash(npx tsc *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>{const p=(JSON.parse(d).tool_input||{}).file_path||'';if(/\\.tsx?$/.test(p)){try{require('child_process').execSync('pnpm -s typecheck',{stdio:'inherit'})}catch(e){process.exit(2)}}})\""
          }
        ]
      }
    ]
  }
}
